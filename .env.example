# Pocket — copiar para ~/homelab/servicos/pocket/.env (fora do git). Significado em CONTRATO.md §8.
# Variável ausente = default do contrato.

# IP da tailnet; nunca 0.0.0.0. No PC (dev): 127.0.0.1:9104
POCKET_LISTEN=100.64.0.10:9104
POCKET_DB=data/pocket.db
# tls/ (fullchain.pem, key.pem) e vapid.json
POCKET_SECRETS=secrets
POCKET_TZ=America/Sao_Paulo

# Definida vazia (POCKET_ACME=) desliga a renovação — dev no PC
POCKET_ACME=~/.acme.sh/acme.sh
POCKET_PUSH_SUBJECT=https://pocket.example.com

# Captura por voz/texto (CONTRATO-FASE15.md §7) — mesma chave do Smaug (a
# cota do Groq é por organização, não por chave). Vazia = captura desligada.
GROQ_API_KEY=
POCKET_CAPTURA_MODELO=openai/gpt-oss-120b
POCKET_TRANSCRICAO_MODELO=whisper-large-v3-turbo
# POCKET_GROQ_URL=https://api.groq.com/openai/v1   # só no dev: aponta para um Groq falso local
